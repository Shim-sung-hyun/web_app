{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charum-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",

  // 개발자 Cloudflare AI: 여기서는 바인딩만. 키·토큰은 파일에 넣지 않는다.
  "ai": {
    "binding": "AI"
  },

  // 개발자 키 사용자별 하루 3회 제한용. 아래 id는 배포할 때 wrangler가 알려 주는 값으로 바꾼다.
  "kv_namespaces": [
    { "binding": "LIMITS", "id": "REPLACE_WITH_KV_ID" }
  ],

  "vars": {
    // 정식판은 charum.org에서 불러오므로 두 주소가 꼭 있어야 한다.
    "ALLOW": "https://shim-sung-hyun.github.io,https://www.charum.org,https://charum.org,http://localhost:8787",
    "DAILY_LIMIT": "3",
    "FLUX_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct"
  },

  "observability": {
    "enabled": true
  }
}
