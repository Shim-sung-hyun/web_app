{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charum-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",

  // 개발자 Cloudflare AI: 여기서는 바인딩만. 키·토큰은 파일에 넣지 않는다.
  "ai": {
    "binding": "AI"
  },

  // 하루 3회 제한 / TTS 캐시용. 코드가 env.KV를 쓰므로 binding 이름은 꼭 "KV"여야 한다.
  // 아래 id는 `wrangler kv namespace create KV`가 알려주는 값으로 바꾼다.
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_KV_ID" }
  ],

  // 허용 주소(ALLOW)·모델·하루 횟수는 코드 상수에 들어 있다. 시크릿은 이 파일에 넣지 않는다.
  "vars": {},

  "observability": {
    "enabled": true
  }
}
